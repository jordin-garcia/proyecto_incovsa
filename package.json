{
  "name": "incovsa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "crear-admin": "tsx scripts/crear-admin.ts",
    "build": "next build",
    "start": "next start",
    "formato": "prettier --check .",
    "formato:arreglar": "prettier --write .",
    "lint": "eslint .",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verificar": "npm run formato && npm run lint && npm run tipos && npm test",
    "db:migrar": "prisma migrate dev",
    "db:aplicar": "prisma migrate deploy",
    "db:reiniciar": "prisma migrate reset --force",
    "db:semilla": "tsx prisma/seed.ts",
    "semilla:demo": "tsx prisma/semilla-demo.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "test:mutacion": "node scripts/ejecutar-mutacion.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-type": "^22.2.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.2",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lockfile-lint": "5.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    },
    "typed-rest-client": {
      "qs": "6.16.1"
    }
