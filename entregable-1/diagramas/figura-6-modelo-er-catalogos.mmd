%% Acceso y camiones. Nombres de prisma/schema.prisma.
%% Sin rol como entidad, sin sector, sin cliente, sin catálogo de productos
%% y sin existencia, traslado ni movimiento de inventario (specs/14, RN-40).
erDiagram
    Sede ||--o{ UsuarioSede : asigna
    Usuario ||--o{ UsuarioSede : "sedes del picking"
    Permiso ||--o{ UsuarioPermiso : concede
    Usuario ||--o{ UsuarioPermiso : tiene
    Sede ||--o{ Camion : posee
    Usuario |o--o{ Bitacora : registra

    Sede {
        string nombre
        string prefijoOdoo
        boolean tieneOficina
    }
    Usuario {
        string displayUsername
        string rol
        string sistema
        boolean activo
    }
    Permiso {
        string codigo
        string sistema
        string modulo
        string accion
    }
    Camion {
        string identificacion
        decimal capacidadKg
    }
    Bitacora {
        string sistema
        string operacion
        string detalle
    }
