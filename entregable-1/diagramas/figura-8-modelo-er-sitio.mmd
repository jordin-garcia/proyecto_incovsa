    ContenidoInstitucional ||--o{ Imagen : galeria
    Industria ||--o{ Imagen : galeria
    ProductoSitio ||--o{ Imagen : galeria
    Noticia ||--o{ Imagen : galeria
    Industria ||--o{ ProductoIndustria : clasifica
    ProductoSitio ||--o{ ProductoIndustria : pertenece
    Usuario ||--o{ Noticia : crea
    Pais ||--o{ ProductoDocumentado : origen
    Usuario ||--o{ ProductoDocumentado : crea
    Sede ||--o| InformacionContacto : "solo con oficina"
