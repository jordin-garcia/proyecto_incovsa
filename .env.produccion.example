# Ejemplo de producción (CE-05, RNF-10). Copiar a .env en el VPS. Nunca valores reales.

# --- PostgreSQL 18, solo dentro de la red de Docker ---
POSTGRES_USER=incovsa
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=incovsa
DATABASE_URL=postgresql://incovsa:cambie-esta-clave@postgres:5432/incovsa

# --- Autenticación ---
BETTER_AUTH_SECRET_SITIO=cambie-esto-por-una-clave-aleatoria-de-32-caracteres
BETTER_AUTH_SECRET_PICKING=cambie-esto-por-otra-clave-aleatoria-de-32-caracteres
BETTER_AUTH_URL=https://incovsa.com
SESION_DIAS=7

# --- Imágenes en Cloudflare R2 (decisión 78) ---
ALMACENAMIENTO=r2
R2_CUENTA=ejemplo-de-cuenta
R2_LLAVE=ejemplo-de-llave
R2_SECRETO=ejemplo-de-secreto
R2_BUCKET_IMAGENES=incovsa-imagenes
URL_IMAGENES=https://imagenes.incovsa.com

# --- Respaldos (CE-07): remoto rclone al bucket privado de R2 ---
# Las llaves viven en la config de rclone del VPS, no aquí.
RCLONE_DEST=r2:incovsa-respaldos

# --- Imagen de la aplicación (CE-06 / CE-08) ---
# CE-06 publica ghcr.io/<owner>/<repo>:<sha> y :produccion, no :latest. Sin IMAGEN_APP, Compose usa :produccion.
# IMAGEN_APP=ghcr.io/jordin-garcia/proyecto_incovsa:produccion

# --- Otros ---
URL_ODOO=
TIEMPO_REAL_CONSULTA_MS=5000
DOMINIO=incovsa.com
