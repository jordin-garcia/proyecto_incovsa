# Variables de entorno de INCOVSA. Copie este archivo a .env y escriba sus propios valores.
# Este ejemplo nunca lleva valores reales (RNF-10). Producción usa .env.produccion.example (CE-05).

# --- Base de datos (PostgreSQL 18) ---
# Base de desarrollo. Cambie USUARIO y CONTRASENA por los de su PostgreSQL local.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/incovsa"
# Base de pruebas: la usa `npm test`, nunca la de desarrollo (JG-03).
DATABASE_URL_PRUEBAS="postgresql://USUARIO:CONTRASENA@localhost:5432/incovsa_pruebas"

# --- Autenticación (Better Auth, una configuración por sistema: specs/16, decisión 35) ---
# Clave para firmar las sesiones del sitio. Al menos 32 caracteres aleatorios: `openssl rand -base64 32`.
BETTER_AUTH_SECRET_SITIO="cambie-esto-por-una-clave-aleatoria-de-32-caracteres"
# Clave para firmar las sesiones del picking. Distinta de la del sitio.
BETTER_AUTH_SECRET_PICKING="cambie-esto-por-otra-clave-aleatoria-de-32-caracteres"
# Dirección pública de la aplicación.
BETTER_AUTH_URL="http://localhost:3000"
# Días sin uso antes de que expire una sesión; se renueva una vez al día mientras se usa (P-07, decisión 36).
SESION_DIAS=7

# --- Datos de demostración ---
# Contraseña de las cuentas de ejemplo (ejemplo.01 a ejemplo.11) que crea `npm run semilla:demo`. Mínimo 8 caracteres.
CLAVE_DEMO="cambie-esta-clave"

# --- Imágenes (decisión 78) ---
# Dónde se guardan las imágenes: `disco` (desarrollo y GitHub Actions, en almacenamiento-local/) o `r2` (producción).
ALMACENAMIENTO=disco
# Solo con ALMACENAMIENTO=r2: identificador de la cuenta de Cloudflare.
R2_CUENTA=""
# Solo con ALMACENAMIENTO=r2: identificador de la llave de acceso de R2.
R2_LLAVE=""
# Solo con ALMACENAMIENTO=r2: secreto de la llave de acceso de R2.
R2_SECRETO=""
# Solo con ALMACENAMIENTO=r2: nombre del bucket de las imágenes del sitio.
R2_BUCKET_IMAGENES=""
# Solo con ALMACENAMIENTO=r2: dirección pública de las imágenes, por ejemplo https://imagenes.incovsa.com (sin / al final).
URL_IMAGENES=""

# --- Otros ---
# Dirección de Odoo que abre el acceso personal. Vacía mientras INCOVSA no la defina (P-06).
URL_ODOO=""
# Cada cuántos milisegundos consulta una pantalla si no hay conexión de avisos en tiempo real (decisión 10).
TIEMPO_REAL_CONSULTA_MS=5000
