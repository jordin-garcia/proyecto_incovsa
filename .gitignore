# Variables de entorno: solo se sube el ejemplo
.env*
!.env.example
!.env.produccion.example

# Dependencias y archivos generados
node_modules/
.next/
__pycache__/
/out/
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts
# Cliente de Prisma: lo genera `prisma generate` (postinstall)
/src/generated/
.DS_Store
npm-debug.log*

# Resultados de Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/.playwright-mcp/

# Archivos subidos por los usuarios: imágenes con ALMACENAMIENTO=disco (specs/16, decisión 78)
/almacenamiento-local/

# Documentación del curso y datos de la empresa: se guardan en la carpeta local y en Google Drive
docs/
docs_incovsa/

# Documentos entregables en Word y PDF
entregable-*/**/*.docx
entregable-*/**/*.pdf

# Evidencias con fotografías de personas y de la empresa (Anexo B)
entregable-*/figuras/evidencias/

# El prototipo de simulación armado (entregable-1/prototipos/prototipo-simulacion-incovsa.html) SÍ se sube
# desde el 16/10/2026: contiene datos reales de la empresa, pero el repositorio es privado (specs/16, decisión 63).

# Notas de investigación (el informe final está en plan/)
research_notes/

# Datos locales de los documentos (nombres y carnés del equipo)
entregable-*/**/*.local.json
entregable-*/*.local.json

# Configuración personal de Claude Code
.claude/settings.local.json

# Archivos temporales de Office
~$*
